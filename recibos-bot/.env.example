# ============================================================================
# recibos-bot — copie para /etc/recibos-bot.env (produção) ou .env (dev)
# e preencha. NUNCA commite o arquivo preenchido.
# ============================================================================

# --- WhatsApp Cloud API (Meta) ----------------------------------------------
# Token de acesso do System User (permissões whatsapp_business_messaging e
# whatsapp_business_management). Business Settings > Users > System users.
WHATSAPP_TOKEN=EAAG...

# ID do número do WhatsApp Business (não é o telefone!).
# developers.facebook.com > seu app > WhatsApp > API Setup > "Phone number ID"
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# App Secret — usado para validar o X-Hub-Signature-256 dos POSTs.
# developers.facebook.com > seu app > App settings > Basic > App secret
WHATSAPP_APP_SECRET=

# Token que VOCÊ inventa e cola também no painel da Meta ao registrar o webhook.
# Gere com:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_VERIFY_TOKEN=

# Versão da Graph API. Atualize quando a Meta descontinuar a atual.
GRAPH_API_VERSION=v23.0

# --- Você ------------------------------------------------------------------
# SEU número (só dígitos, com DDI 55 + DDD). É o ÚNICO número com quem o bot
# conversa: mensagens de outros são ignoradas e envios para outros são bloqueados.
OWNER_PHONE=5511987654321

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high — quanto o modelo "pensa" antes de responder.
ANTHROPIC_EFFORT=medium

# --- Armazenamento e fuso ---------------------------------------------------
# Em produção (systemd) use o StateDirectory; em dev pode ser data/recibos.db
DB_PATH=/var/lib/recibos-bot/recibos.db
TIMEZONE=America/Sao_Paulo

# --- Categorias (separadas por vírgula; "Outros" é sempre incluída) ---------
CATEGORIES=Mercado,Farmácia,Restaurante,Lanche/Café,Transporte,Combustível,Compras online,Vestuário,Casa,Saúde,Lazer,Serviços,Outros

# --- Resumo mensal ------------------------------------------------------------
SUMMARY_TITLE=Compras no cartão
# Mostra a linha "Metade (50%)" no fim do resumo.
SUMMARY_SHOW_SPLIT=true

# Template aprovado na Meta para o envio automático do dia 1 quando a janela de
# 24h estiver fechada (veja o README). Deixe vazio para não usar.
SUMMARY_TEMPLATE_NAME=
SUMMARY_TEMPLATE_LANG=pt_BR

LOG_LEVEL=INFO
